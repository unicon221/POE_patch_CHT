// UTF-8 source
#pragma code_page(65001)
#include <windows.h>

/* 应用程序图标 (资源 ID 1, Explorer/taskbar 使用) */
1 ICON "app.ico"

/* 版本信息 - 全 ASCII 以避免不同 windres 的编码差异 */
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PoE Tools"
            VALUE "FileDescription",  "Path of Exile CHT Language + Font Patcher (Steam)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "poe_patch"
            VALUE "OriginalFilename", "poe_patch.exe"
            VALUE "ProductName",      "POE_patch_CHT"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "Comments",         "Steam version only. Requires oo2core.dll (not bundled)."
            VALUE "LegalCopyright",   "MIT License. UI: CUI (MIT)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
